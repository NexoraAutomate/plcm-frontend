# Browser-facing API base URL (must be reachable from the user's machine/browser).
# If this points at localhost/127.0.0.1, the frontend rewrites the hostname to
# match the page origin so LAN clients (other PCs) reach the host's API.
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Next.js server port (used by `next start` / Docker)
PORT=3000
